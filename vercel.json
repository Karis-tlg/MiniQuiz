{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "cleanUrls": true,
    "framework": "vite",
    "buildCommand": "cd frontend && npm run build",
    "devCommand": "cd frontend && npm run dev",
    "outputDirectory": "frontend/dist",
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api" }
    ]
}
